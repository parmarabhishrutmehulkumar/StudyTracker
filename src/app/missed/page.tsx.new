'use client';

import { useEffect, useState } from 'react';
import { useStore } from '@/store/useStore';
import LayoutWrapper from '@/components/layout-wrapper';
import {
  AlertTriangle,
  Zap,
  AlertOctagon,
  BookOpen,
  Brain,
  MoreVertical,
  Check,
  ExternalLink,
  AlertCircle,
  Clock,
  TrendingDown,
  Sparkles,
  Loader2,
} from 'lucide-react';
import { getLocalDateString } from '@/lib/utils';
import { toast } from 'sonner';

interface OverdueTask {
  id: string;
  title: string;
  subject: string;
  daysOverdue: number;
  hours?: number;
  priority: 'high' | 'medium' | 'low';
}

interface DelayedChapter {
  subject: string;
  chapter: string;
  daysDelayed: number;
  progress: number;
}

interface SRSCard {
  id: string;
  topic: string;
  recallStrength: number;
  missedDay: number;
  priority: 'high' | 'medium';
}

const subjectColors: { [key: string]: { bg: string; text: string } } = {
  Math: { bg: 'bg-amber-100', text: 'text-amber-900' },
  Science: { bg: 'bg-emerald-100', text: 'text-emerald-900' },
  Humanities: { bg: 'bg-blue-100', text: 'text-blue-900' },
  Biology: { bg: 'bg-green-100', text: 'text-green-900' },
  Languages: { bg: 'bg-purple-100', text: 'text-purple-900' },
};

export default function MissedTasksPage() {
  const [isLoading, setIsLoading] = useState(false);
  const [completedTasks, setCompletedTasks] = useState<Set<string>>(new Set());

  const mockOverdueTasks: OverdueTask[] = [
    {
      id: 'hw1',
      title: 'Calculus: Integral Application',
      subject: 'Math',
      daysOverdue: 2,
      priority: 'high',
    },
    {
      id: 'hw2',
      title: 'Organic Chemistry Lab Report',
      subject: 'Science',
      daysOverdue: 0,
      hours: 12,
      priority: 'high',
    },
    {
      id: 'hw3',
      title: 'Renaissance History Summary',
      subject: 'Humanities',
      daysOverdue: 3,
      priority: 'low',
    },
  ];

  const mockDelayedChapters: DelayedChapter[] = [
    {
      subject: 'PHYSICS',
      chapter: 'Thermodynamics',
      daysDelayed: 4,
      progress: 65,
    },
    {
      subject: 'LITERATURE',
      chapter: 'Macbeth Act IV',
      daysDelayed: 7,
      progress: 20,
    },
  ];

  const mockSRSCards: SRSCard[] = [
    {
      id: 'srs1',
      topic: 'Cell Biology: Mitosis',
      recallStrength: 12,
      missedDay: 7,
      priority: 'high',
    },
    {
      id: 'srs2',
      topic: 'Statistics: Standard Deviation',
      recallStrength: 45,
      missedDay: 3,
      priority: 'medium',
    },
    {
      id: 'srs3',
      topic: 'French: Subjunctive Mood',
      recallStrength: 38,
      missedDay: 3,
      priority: 'medium',
    },
  ];

  const handleCompleteTask = (taskId: string) => {
    setCompletedTasks((prev) => {
      const updated = new Set(prev);
      if (updated.has(taskId)) {
        updated.delete(taskId);
      } else {
        updated.add(taskId);
      }
      return updated;
    });
    toast.success('Task marked as complete!');
  };

  return (
    <LayoutWrapper title="Missed Tasks">
      <div className="space-y-8 pb-24">
        {/* Smart Suggestion Section - Hero Card */}
        <section className="relative overflow-hidden bg-primary text-white rounded-2xl p-8 md:p-10 flex flex-col md:flex-row items-center gap-8 shadow-lg group hover:shadow-2xl transition-shadow">
          <div className="absolute inset-0 opacity-10 pointer-events-none">
            <div className="absolute top-0 right-0 w-96 h-96 bg-white rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
          </div>

          <div className="relative z-10 flex-1">
            <div className="flex items-center gap-2 mb-3">
              <Sparkles className="w-5 h-5" />
              <span className="text-xs font-semibold uppercase tracking-widest opacity-80">Smart Suggestion</span>
            </div>
            <h3 className="text-2xl md:text-3xl font-bold leading-tight mb-5">
              Urgent: Complete Math Chapter 5 revision first to maintain your <span className="text-amber-200">14-day streak.</span>
            </h3>
            <div className="flex flex-wrap gap-3">
              <button className="bg-emerald-400 text-emerald-900 px-6 py-3 rounded-lg font-semibold hover:bg-emerald-300 transition-colors">
                Start Now
              </button>
              <button className="border border-white/30 text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors">
                Dismiss
              </button>
            </div>
          </div>

          <div className="w-full md:w-48 flex justify-center items-center">
            <div className="relative w-32 h-32">
              <div className="absolute inset-0 rounded-full border-4 border-white/10"></div>
              <div className="absolute inset-4 rounded-full border-4 border-amber-200/40 flex items-center justify-center">
                <div className="text-5xl font-bold text-amber-200">14</div>
              </div>
            </div>
          </div>
        </section>

        {/* Bento Grid Layout */}
        <div className="grid grid-cols-1 md:grid-cols-12 gap-6">
          {/* Overdue Homework - Large Section */}
          <section className="md:col-span-8 flex flex-col gap-4">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-3">
                <AlertTriangle className="w-6 h-6 text-red-500" />
                <h3 className="text-2xl font-bold">Overdue Homework</h3>
              </div>
              <span className="text-xs font-semibold uppercase tracking-wider text-red-600 bg-red-100 px-3 py-1 rounded-full">
                {mockOverdueTasks.length} Tasks Pending
              </span>
            </div>

            <div className="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
              <div className="divide-y divide-slate-200">
                {mockOverdueTasks.map((task, index) => (
                  <div
                    key={task.id}
                    className={`p-4 hover:bg-slate-50 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-l-4 ${
                      completedTasks.has(task.id) ? 'opacity-50 line-through' : ''
                    } ${
                      task.priority === 'high' ? 'border-red-500' : task.priority === 'medium' ? 'border-red-300' : 'border-red-100'
                    }`}
                  >
                    <div className="space-y-2 flex-1">
                      <div className="flex items-center gap-3 flex-wrap">
                        <span className="font-semibold text-slate-900">{task.title}</span>
                        <span className={`text-xs font-semibold px-3 py-1 rounded-lg ${subjectColors[task.subject]?.bg || 'bg-slate-100'} ${subjectColors[task.subject]?.text || 'text-slate-700'}`}>
                          {task.subject}
                        </span>
                      </div>
                      <p className="text-sm text-slate-600 flex items-center gap-2">
                        <Clock className="w-4 h-4" />
                        Overdue by {task.daysOverdue > 0 ? `${task.daysOverdue} day${task.daysOverdue > 1 ? 's' : ''}` : `${task.hours || 0} hours`} • Carry-forward active
                      </p>
                    </div>
                    <div className="flex items-center gap-2">
                      <button
                        onClick={() => handleCompleteTask(task.id)}
                        className="p-2 text-primary hover:bg-primary/5 rounded-lg transition-colors"
                      >
                        <Check className="w-5 h-5" />
                      </button>
                      <button className="p-2 text-slate-600 hover:text-red-500 rounded-lg transition-colors">
                        <MoreVertical className="w-5 h-5" />
                      </button>
                    </div>
                  </div>
                ))}
              </div>
              <div className="bg-slate-50 p-3 text-center border-t border-slate-200">
                <button className="text-primary font-semibold text-sm hover:underline">View All Overdue Homework</button>
              </div>
            </div>
          </section>

          {/* Delayed Chapters - Medium Section */}
          <section className="md:col-span-4 flex flex-col gap-4">
            <div className="flex items-center gap-3">
              <BookOpen className="w-6 h-6 text-amber-600" />
              <h3 className="text-2xl font-bold">Delayed Chapters</h3>
            </div>

            <div className="bg-white rounded-2xl border border-slate-200 p-6 space-y-6 shadow-sm">
              {mockDelayedChapters.map((chapter, index) => (
                <div key={index} className="space-y-2">
                  <div className="flex justify-between items-end gap-2">
                    <div>
                      <p className="text-xs font-semibold text-slate-500 uppercase tracking-wide">{chapter.subject}</p>
                      <p className="font-semibold text-slate-900">{chapter.chapter}</p>
                    </div>
                    <p className="text-xs font-semibold text-red-600">{chapter.daysDelayed} Days Behind</p>
                  </div>
                  <div className="h-2 w-full bg-slate-200 rounded-full overflow-hidden">
                    <div
                      className={`h-full transition-all ${index === 0 ? 'bg-amber-400' : 'bg-primary'}`}
                      style={{ width: `${chapter.progress}%` }}
                    ></div>
                  </div>
                </div>
              ))}

              <div className="pt-4 border-t border-slate-200">
                <div className="flex items-start gap-3 p-3 bg-amber-50 border border-amber-200 rounded-lg">
                  <AlertCircle className="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" />
                  <p className="text-sm text-slate-700">
                    Your syllabus completion is dropping. Estimated delay: <strong>5.2 days</strong>.
                  </p>
                </div>
              </div>
            </div>
          </section>

          {/* Overdue Revision - Full Width Bottom */}
          <section className="md:col-span-12 flex flex-col gap-4">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-3">
                <Brain className="w-6 h-6 text-emerald-600" />
                <h3 className="text-2xl font-bold">Overdue Revision</h3>
              </div>
              <p className="text-xs font-semibold text-slate-500">Spaced Repetition System (SRS) Alerts</p>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {mockSRSCards.map((card) => (
                <div
                  key={card.id}
                  className="bg-white rounded-2xl border border-slate-200 p-5 hover:shadow-lg transition-shadow relative group overflow-hidden"
                >
                  <div className="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity">
                    <button className="p-2 text-slate-600 hover:text-slate-900">
                      <ExternalLink className="w-4 h-4" />
                    </button>
                  </div>

                  <div className="flex items-start gap-4">
                    <div
                      className={`w-12 h-12 rounded-lg flex items-center justify-center flex-shrink-0 ${
                        card.priority === 'high'
                          ? 'bg-red-100 border-2 border-red-500 animate-pulse'
                          : 'bg-blue-100 border border-slate-200'
                      }`}
                    >
                      <AlertTriangle className={`w-6 h-6 ${card.priority === 'high' ? 'text-red-600' : 'text-primary'}`} />
                    </div>
                    <div className="flex-1 min-w-0">
                      <h4 className="font-semibold text-slate-900 truncate text-sm">{card.topic}</h4>
                      <p className="text-xs text-slate-600 mb-4">Recall strength: {card.recallStrength}%</p>
                      <div className="flex items-center justify-between">
                        <span className={`text-xs font-semibold flex items-center gap-1 ${card.priority === 'high' ? 'text-red-600' : 'text-slate-600'}`}>
                          <Clock className="w-3 h-3" />
                          Missed Day {card.missedDay}
                        </span>
                        <button className="text-primary font-semibold text-xs hover:underline">Review Now</button>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        </div>
      </div>
    </LayoutWrapper>
  );
}
